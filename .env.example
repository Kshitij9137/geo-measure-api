# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Leave unset to fall back to a local SQLite file.
DATABASE_URL=postgres://geomeasure:geomeasure@localhost:5432/geomeasure

# Limits
MAX_UPLOAD_SIZE_MB=50
ZIP_MAX_FILES=200
ZIP_MAX_UNCOMPRESSED_MB=500

LOG_LEVEL=INFO
